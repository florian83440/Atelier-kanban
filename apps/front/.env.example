# URL du serveur WebSocket. Par defaut : ws://<hote-actuel>:8080
# A definir seulement si le serveur tourne sur une autre machine / un autre port.
# VITE_SERVER_URL=ws://192.168.1.50:8080
#
# En production (deploiement quai, TLS via Traefik) : URL WSS publique du back,
# figee au build. Voir deploy/deploy-quai.md
# VITE_SERVER_URL=wss://kanban-api.exemple.fr
