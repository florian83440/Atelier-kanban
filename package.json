{
  "name": "kanban-it",
  "private": true,
  "version": "0.1.0",
  "description": "Kanban IT - simulation de flux, jeu multi-equipes en reseau local",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kanban-it/back & npm run dev -w @kanban-it/front",
    "dev:back": "npm run dev -w @kanban-it/back",
    "dev:front": "npm run dev -w @kanban-it/front",
    "dev:server": "npm run dev -w @kanban-it/back",
    "dev:client": "npm run dev -w @kanban-it/front",
    "build": "npm run build -w @kanban-it/front",
    "start": "npm run start -w @kanban-it/back",
    "smoke": "node packages/shared/_smoke.mjs && node apps/back/_smoke.mjs"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
